<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>EliteCreaturesReborn</AssemblyName>
    <RootNamespace>EliteCreaturesReborn</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Version>3.34.1</Version>
    <Product>Elite Creatures Reborn</Product>
    <Authors>Gerald Glasgow</Authors>
    <Company>Gerald Glasgow</Company>
    <Copyright>Copyright (c) Gerald Glasgow. Licensed under the GNU General Public License v3.0.</Copyright>
    <Description>Elite Creatures Reborn: named, visible mutations that make every creature a different fight</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS8618;CS1591;CS0618</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- Paths: override with -p:GamePath=..., -p:BepInExCore=... and -p:ModLibsPath=... if your layout differs -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <ManagedPath>$(GamePath)\valheim_Data\Managed</ManagedPath>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(GamePath)\BepInEx\core\BepInEx.dll')">$(GamePath)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildProjectDirectory)\..\lib\BepInEx\core</BepInExCore>
    <!-- Shared libraries (ValheimModLibs), expected as a sibling checkout -->
    <ModLibsPath Condition="'$(ModLibsPath)' == ''">$(MSBuildProjectDirectory)\..\..\ValheimModLibs</ModLibsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all" />
    <!-- The rule files are read with YamlDotNet directly, not through YamlConfig -->
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(ModLibsPath)\Charter\Charter.csproj" />
    <ProjectReference Include="$(ModLibsPath)\ConfigReload\ConfigReload.csproj" />
    <ProjectReference Include="$(ModLibsPath)\PatchGuard\PatchGuard.csproj" />
    <ProjectReference Include="$(ModLibsPath)\PlateColumn\PlateColumn.csproj" />
    <ProjectReference Include="$(ModLibsPath)\LocalEffects\LocalEffects.csproj" />
    <ProjectReference Include="$(ModLibsPath)\PlayerGrid\PlayerGrid.csproj" />
    <ProjectReference Include="$(ModLibsPath)\Hotkeys\Hotkeys.csproj" />
    <ProjectReference Include="$(ModLibsPath)\WindowInput\WindowInput.csproj" />
    <!-- RecipeCounts: eggs from starred hens count for recipes. -->
    <ProjectReference Include="$(ModLibsPath)\RecipeCounts\RecipeCounts.csproj" />
    <!-- The raids' test marker (NetPrefabs, PrefabBench); the Raiders Chest builds on it too. -->
    <ProjectReference Include="$(ModLibsPath)\BundlePrefabs\BundlePrefabs.csproj" />
    <!-- EliteCraftingLink: Hel's Trial pays EliteCrafting's runes and essence only where it is installed (reflection, no reference). -->
    <ProjectReference Include="$(ModLibsPath)\EliteCraftingLink\EliteCraftingLink.csproj" />
    <!-- Translations: the player-facing words, English embedded from translations\, other languages from files. -->
    <ProjectReference Include="$(ModLibsPath)\Translations\Translations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The world tier plate's icon, loaded by name as EliteCreaturesReborn.assets.<file>. -->
    <EmbeddedResource Include="assets\*.png" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
    <!-- The words, read by the Translations library as EliteCreaturesReborn.translations.<Language>[.<part>].yml. -->
    <EmbeddedResource Include="translations\*.yml" LogicalName="EliteCreaturesReborn.translations.%(Filename)%(Extension)" />
    <!-- The Raiders Chest's model and icon (ValheimAssets Assets/Props/RaidersChest), one bundle per platform: Windows
         for clients, Linux for dedicated servers. Loaded by BundlePrefabs' EmbeddedBundle. -->
    <EmbeddedResource Include="assets\bundles\ecr_raiders_chest.*" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
    <!-- Hel's arena (features/arena.md section 1). From the indoor hall (ValheimAssets Assets/Locations/HelHall) only the
         throne (ecr_helhall_throne) and the archways' portal (Assets/Effects/ecr_helhall_portal, bundle
         ecr_helhall_portalfx, drawn on clients by Arena/Trial/ArenaPortalLook). -->
    <EmbeddedResource Include="assets\bundles\ecr_helhall_*.*" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
    <!-- The outdoor arena (Assets/Locations/HelArena, CONTRACT.md): floor, walls and cover on every peer, the land and
         mountains on clients, one bundle each per platform, built by Arena/Hall. -->
    <EmbeddedResource Include="assets\bundles\ecr_helarena_*.*" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
    <!-- Hel on her throne and her spear (ValheimAssets Assets/Creatures/Hel/ecp_hel, bundle ecr_hel). -->
    <EmbeddedResource Include="assets\bundles\ecr_hel.*" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
    <!-- Helgrind, Hel's gate (ValheimAssets Assets/Props/HelGate/ecr_helgate, bundle ecr_helgate) and its swirl
         (Assets/Effects/ecr_helgate_swirl, bundle ecr_helgatefx), built on every peer by Arena/Gate. -->
    <EmbeddedResource Include="assets\bundles\ecr_helgate*.*" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
    <!-- The Bat-fiend, one of Hel's creatures (ValheimAssets Assets/Creatures/HelsCreatures/BatFiend, v002; bundle
         ecr_batfiend from its Tools/v002/build_bundle_v002.ps1), built on every peer by Creatures/BatFiend. -->
    <EmbeddedResource Include="assets\bundles\ecr_batfiend.*" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
    <!-- The Rendering Table's model and icon (ValheimAssets Assets/Props/RenderingTable, bundle ecr_renderingtable),
         built on every peer by Rendering/RenderModel. -->
    <EmbeddedResource Include="assets\bundles\ecr_renderingtable.*" LogicalName="EliteCreaturesReborn.assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedPath)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The Raiders Chest's embedded bundle (AssetBundle). -->
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The death recap's end-of-frame screen capture. -->
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(ManagedPath)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ILRepack.targets in this directory is imported automatically by ILRepack.Lib.MSBuild.Task -->

</Project>
