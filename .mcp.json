{
  "mcpServers": {
    "blender": {
      "command": "${USERPROFILE}/.local/bin/uvx.exe",
      "args": ["mcp-for-blender"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    },
    "unity": {
      "command": "${USERPROFILE}/.local/bin/uvx.exe",
      "args": ["--from", "mcpforunityserver==10.2.0", "mcp-for-unity", "--transport", "stdio"],
      "env": {
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
