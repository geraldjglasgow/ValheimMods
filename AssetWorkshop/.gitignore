# Blender and Unity output, all regenerated by build.ps1
assets/*/out/
out/
__pycache__/

# Unity's generated folders, and the assets build.ps1 stages into the project
unity/Library/
unity/Temp/
unity/Logs/
unity/UserSettings/
unity/obj/
unity/.vs/
unity/*.csproj
unity/*.sln
unity/Assets/Bundles/
unity/Assets/Bundles.meta

# Creatures staged by the build, copies of the game's assets for previews (never committed), the generated scene
unity/Assets/Creatures/
unity/Assets/Creatures.meta
unity/Assets/Reference/
unity/Assets/Reference.meta
unity/Assets/Preview/*.unity
unity/Assets/Preview/*.unity.meta
