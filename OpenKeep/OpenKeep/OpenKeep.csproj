<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>OpenKeep</AssemblyName>
    <RootNamespace>OpenKeep</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>4.0.0</Version>
    <Product>OpenKeep</Product>
    <Description>OpenKeep: storage and inventory for Valheim</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1591</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Paths: override with -p:GamePath=..., -p:BepInExCore=... and -p:ModLibsPath=... if your layout differs -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <ManagedPath>$(GamePath)\valheim_Data\Managed</ManagedPath>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(GamePath)\BepInEx\core\BepInEx.dll')">$(GamePath)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildProjectDirectory)\..\lib\BepInEx\core</BepInExCore>
    <!-- Shared libraries (ValheimModLibs), expected as a sibling checkout -->
    <ModLibsPath Condition="'$(ModLibsPath)' == ''">$(MSBuildProjectDirectory)\..\..\ValheimModLibs</ModLibsPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.46" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- SyncedConfig transitively brings Charter, ConfigReload, YamlConfig and YamlDotNet -->
    <ProjectReference Include="$(ModLibsPath)\Charter\Charter.csproj" />
    <ProjectReference Include="$(ModLibsPath)\SyncedConfig\SyncedConfig.csproj" />
    <ProjectReference Include="$(ModLibsPath)\PatchGuard\PatchGuard.csproj" />
    <ProjectReference Include="$(ModLibsPath)\ItemCopies\ItemCopies.csproj" />
    <ProjectReference Include="$(ModLibsPath)\PlateColumn\PlateColumn.csproj" />
    <ProjectReference Include="$(ModLibsPath)\AreaLoading\AreaLoading.csproj" />
    <ProjectReference Include="$(ModLibsPath)\MapClicks\MapClicks.csproj" />
    <!-- WindowInput: the Site planner's queue panel treated like a game window (free cursor, no attacks, Esc closes) -->
    <ProjectReference Include="$(ModLibsPath)\WindowInput\WindowInput.csproj" />
    <!-- Hotkeys: every OpenKeep hotkey read the workspace's way (Core/Keys passes them on) -->
    <ProjectReference Include="$(ModLibsPath)\Hotkeys\Hotkeys.csproj" />
    <!-- EliteCraftingLink: Salvage asks EliteCrafting which rune a Magic or Rare item may give back -->
    <ProjectReference Include="$(ModLibsPath)\EliteCraftingLink\EliteCraftingLink.csproj" />
    <!-- BundlePrefabs: Mímir's Chest's model and icon, an embedded bundle per platform -->
    <ProjectReference Include="$(ModLibsPath)\BundlePrefabs\BundlePrefabs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>$(ManagedPath)\gui_framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Splatform: the platform user id a placed piece records as its creator's (Blueprints module) -->
    <Reference Include="Splatform">
      <HintPath>$(ManagedPath)\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedPath)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(ManagedPath)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedPath)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Default YAML files, written next to the .cfg when none exists. Add a file to config/ and it is embedded. -->
    <EmbeddedResource Include="config\*.yml" LogicalName="OpenKeep.config.%(Filename)%(Extension)" />
    <!-- UI images, decoded at runtime through the game's ImageConversion (StowSprites.Decode, by reflection: the
         module targets netstandard 2.1). Keep them small: the in-game size, not the source. -->
    <EmbeddedResource Include="assets\*.png" LogicalName="OpenKeep.assets.%(Filename)%(Extension)" />
    <!-- Blueprints written into BepInEx/config/OpenKeep.Blueprints the first time (Blueprints module): OpenKeep.blueprints.<file> -->
    <EmbeddedResource Include="blueprints\*.json" LogicalName="OpenKeep.blueprints.%(Filename)%(Extension)" />
    <!-- Mímir's Chest's model, lid and icon (ValheimAssets Assets/Props/MimirsChest), one bundle per platform -->
    <EmbeddedResource Include="assets\bundles\ok_mimirchest.*" LogicalName="OpenKeep.assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- ILRepack.targets in this directory is imported automatically by ILRepack.Lib.MSBuild.Task -->

</Project>
