<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Sample.HaloMenuDemo</AssemblyName>
    <RootNamespace>Sample.HaloMenuDemo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Product>Sample.HaloMenuDemo</Product>
    <Description>
      Not a real mod. Proves HaloMenu.API.dll is a self-contained contract: this project references only
      HaloMenu.API.csproj, never HaloMenu.csproj, and must compile and load whether or not HaloMenu itself is
      installed. See README.md in this folder.
    </Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS1591</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <ManagedPath>$(GamePath)\valheim_Data\Managed</ManagedPath>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(GamePath)\BepInEx\core\BepInEx.dll')">$(GamePath)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildProjectDirectory)\..\lib\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- The one dependency that matters for this sample: HaloMenu.API only. -->
  <ItemGroup>
    <ProjectReference Include="..\HaloMenu.API\HaloMenu.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim" Publicize="true">
      <HintPath>$(ManagedPath)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    No libraries to merge here (this project deliberately has none besides HaloMenu.API), so a plain copy is
    enough - unlike HaloMenu/ILRepack.targets there is no ILRepack step. Both this DLL and HaloMenu.API.dll need
    to land in BepInEx/plugins together, the same pairing rule as HaloMenu.dll + HaloMenu.API.dll.
  -->
  <Target Name="CopyToDist" AfterTargets="Build">
    <PropertyGroup>
      <TestPluginsPath Condition="'$(TestPluginsPath)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\LocalTesting\BepInEx\plugins</TestPluginsPath>
    </PropertyGroup>
    <ItemGroup>
      <SampleOutputs Include="$(TargetPath);$(OutDir)HaloMenu.API.dll" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\Sample.HaloMenuDemo\dist" />
    <Copy SourceFiles="@(SampleOutputs)" DestinationFolder="$(MSBuildProjectDirectory)\..\Sample.HaloMenuDemo\dist" />
    <Copy SourceFiles="@(SampleOutputs)" DestinationFolder="$(GamePath)\BepInEx\plugins" Condition="Exists('$(GamePath)\BepInEx\plugins')" />
    <Copy SourceFiles="@(SampleOutputs)" DestinationFolder="$(TestPluginsPath)" Condition="Exists('$(TestPluginsPath)')" />
    <Message Importance="high" Text="Sample.HaloMenuDemo build finished: $(MSBuildProjectDirectory)\..\Sample.HaloMenuDemo\dist\Sample.HaloMenuDemo.dll (+ HaloMenu.API.dll)" />
  </Target>

</Project>
