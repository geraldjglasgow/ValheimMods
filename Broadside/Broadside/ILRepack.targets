<Project>
  <!-- Merges the shared libraries into the plugin so a single DLL can be shipped. -->
  <Target Name="ILRepacker" AfterTargets="Build">
    <PropertyGroup>
      <!-- r2modman profile used for testing on this machine, override with -p:TestPluginsPath=... -->
      <TestPluginsPath Condition="'$(TestPluginsPath)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\LocalTesting\BepInEx\plugins</TestPluginsPath>
    </PropertyGroup>
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(OutDir)PatchGuard.dll" />
      <InputAssemblies Include="$(OutDir)BundlePrefabs.dll" />
      <InputAssemblies Include="$(OutDir)BlueprintShelf.dll" />
      <InputAssemblies Include="$(OutDir)WindowInput.dll" />
      <InputAssemblies Include="$(OutDir)PlateColumn.dll" />
      <InputAssemblies Include="$(OutDir)BuildCamera.dll" />
      <InputAssemblies Include="$(OutDir)LimbIk.dll" />
      <InputAssemblies Include="$(OutDir)Hotkeys.dll" />
      <InputAssemblies Include="$(OutDir)MannedWeapons.dll" />
      <InputAssemblies Include="$(OutDir)LocalEffects.dll" />
    </ItemGroup>
    <ItemGroup>
      <LibraryPaths Include="$(OutDir)" />
      <LibraryPaths Include="$(ManagedPath)" />
      <LibraryPaths Include="$(BepInExCore)" />
    </ItemGroup>
    <ILRepack Parallel="true" DebugInfo="false" Internalize="true" InputAssemblies="@(InputAssemblies)"
              OutputFile="$(TargetPath)" TargetKind="SameAsPrimaryAssembly" LibraryPath="@(LibraryPaths)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\dist" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\BepInEx\plugins" Condition="Exists('$(GamePath)\BepInEx\plugins')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TestPluginsPath)" Condition="Exists('$(TestPluginsPath)')" />
    <Message Importance="high" Text="Broadside build finished: $(MSBuildProjectDirectory)\..\dist\Broadside.dll" />
  </Target>
</Project>
